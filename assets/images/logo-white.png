<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 60" width="200" height="60">
  <!-- PFOPL Logo - White Version for dark backgrounds -->
  <defs>
    <linearGradient id="accentGradientWhite" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#22d3ee"/>
      <stop offset="100%" style="stop-color:#67e8f9"/>
    </linearGradient>
  </defs>

  <!-- P Symbol -->
  <g transform="translate(5, 5)">
    <!-- Main P shape - outer -->
    <path d="M8 0 C4 0 0 4 0 8 L0 42 C0 46 3 50 8 50 L12 50 C16 50 18 47 18 44 L18 32 C24 32 32 30 36 24 C40 18 40 10 36 4 C32 -2 24 0 18 0 L8 0 Z" fill="#ffffff"/>
    <!-- Inner accent curve -->
    <path d="M18 8 C22 8 26 10 28 14 C30 18 30 22 28 26 C26 30 22 32 18 32 L18 8 Z" fill="url(#accentGradientWhite)"/>
    <!-- Vertical accent line -->
    <path d="M12 26 L12 44 C12 45 13 46 14 46 L16 46 C17 46 18 45 18 44 L18 26 L12 26 Z" fill="url(#accentGradientWhite)"/>
  </g>

  <!-- PFOPL Text -->
  <text x="55" y="38" font-family="Inter, Arial, sans-serif" font-size="24" font-weight="700" fill="#ffffff">PFOPL</text>
</svg>
